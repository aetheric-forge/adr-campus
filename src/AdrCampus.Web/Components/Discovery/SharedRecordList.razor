@using AdrCampus.Application.Discovery
@using AdrCampus.Core.Discovery
@using AdrCampus.Core.Domain
@using AdrCampus.Web.Drafts
@using AdrCampus.Web.Members
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DiscoveryApplicationService Discovery
@inject CurrentOrganization Organization
@inject MemberRosterService Roster

@if (_loading)
{
    <section class="placeholder-panel" aria-live="polite"><h2>Loading @ViewLabel.ToLowerInvariant()</h2></section>
}
else if (_result?.Status == DiscoveryQueryStatus.Unauthorized)
{
    <section class="placeholder-panel" role="alert"><h2>Decision record unavailable</h2><p>Current organization membership could not be established.</p></section>
}
else if (_result?.Status == DiscoveryQueryStatus.Unavailable)
{
    <section class="placeholder-panel" role="alert"><h2>Decision record temporarily unavailable</h2><p>No partial result set is being shown. Refresh the page to try again.</p></section>
}
else if (_result?.IsOrganizationEmpty == true)
{
    <section class="empty-state"><span class="empty-icon" aria-hidden="true">A</span><h2>No shared ADRs yet</h2><p>Records become visible to the organization when an author proposes a complete draft.</p><a class="button button-secondary" href="drafts/new">Draft the first decision</a></section>
}
else if (_result?.IsViewEmpty == true)
{
    <section class="placeholder-panel"><h2>@EmptyTitle</h2><p>@EmptyMessage</p></section>
}
else if (_result is { IsSuccess: true })
{
    <section class="draft-list" aria-label="@ViewLabel">
        @foreach (var item in _result.Items)
        {
            <a class="draft-row" href="@($"proposals/{item.Id.Value:D}")">
                <span class="draft-identity">
                    <strong>@item.Title.Value</strong>
                    <small>ADR @item.Id.Value.ToString("D") · Author @_names.For(item.AuthorId.Value)</small>
                    <small>@item.RelevantActorRole @_names.For(item.RelevantActorId.Value) · @EventLabel(item.Status) @item.RelevantAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small>
                </span>
                <span class="role-badge @StatusClass(item.Status)">@item.Status</span>
            </a>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public SharedRecordView View { get; set; }
    [Parameter, EditorRequired] public string ViewLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EmptyTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EmptyMessage { get; set; } = string.Empty;

    private DiscoveryQueryResult? _result;
    private MemberDisplayNames _names = new(false, new Dictionary<string, string>());
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var subjectId = authentication.User.FindFirst("sub")?.Value;
            if (string.IsNullOrWhiteSpace(subjectId))
            {
                _result = DiscoveryQueryResult.Unauthorized();
                return;
            }

            _result = await Discovery.BrowseAsync(new DiscoveryQuery(Organization.Id, new MemberId(subjectId), View));
            if (_result.IsSuccess && _result.Items.Count > 0)
            {
                _names = await Roster.GetDisplayNamesAsync();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private static string EventLabel(AdrLifecycleStatus status) => status switch
    {
        AdrLifecycleStatus.Proposed => "Proposed",
        AdrLifecycleStatus.Accepted => "Accepted",
        AdrLifecycleStatus.Rejected => "Rejected",
        AdrLifecycleStatus.Superseded => "Superseded",
        _ => "Updated"
    };

    private static string StatusClass(AdrLifecycleStatus status) => status switch
    {
        AdrLifecycleStatus.Accepted => "role-accepted",
        AdrLifecycleStatus.Rejected => "role-rejected",
        AdrLifecycleStatus.Superseded => "role-superseded",
        _ => "role-proposed"
    };
}
