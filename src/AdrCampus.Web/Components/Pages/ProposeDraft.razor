@page "/drafts/{DraftId:guid}/propose"
@using AdrCampus.Application.Proposals
@using AdrCampus.Core.Domain
@using AdrCampus.Core.Proposals
@using AdrCampus.Web.Drafts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProposalApplicationService Proposals
@inject CurrentOrganization Organization
@inject NavigationManager Navigation
<PageTitle>Propose ADR</PageTitle>
@if (_loading) { <section class="placeholder-panel"><h1>Preparing proposal</h1></section> }
else if (_prepared?.Draft is null) { <section class="placeholder-panel"><h1>Draft not found</h1><a class="button button-secondary" href="drafts">My drafts</a></section> }
else if (!_prepared.IsReady) { <div class="page-header"><div><span class="eyebrow">Proposal validation</span><h1>@_prepared.Draft.Content.Title.Value</h1><p>Complete these sections before proposing the ADR.</p></div></div><section class="placeholder-panel form-error"><h2>Proposal is not ready</h2><ul>@foreach (var error in _prepared.Errors) { <li><strong>@error.Field:</strong> @error.Message</li> }</ul><a class="button button-primary" href="@($"drafts/{DraftId:D}/edit")">Edit draft</a></section> }
else { <div class="preview-banner">Confirmation required · Proposal makes this content visible to all active members and read-only</div><div class="page-header"><div><span class="eyebrow">Proposal preview</span><h1>@_prepared.Content!.Title.Value</h1><p>Confirming proposes exactly version @_prepared.Draft.Version.</p></div></div>@if (_error is not null) { <div class="form-message form-error" role="alert">@_error</div> }<article class="adr-preview"><section><h2>Context</h2><p>@_prepared.Content.Context</p></section><section><h2>Decision</h2><p>@_prepared.Content.Decision</p></section><section><h2>Consequences</h2><p>@_prepared.Content.Consequences</p></section></article><div class="confirmation-actions"><a class="button button-secondary" href="@($"drafts/{DraftId:D}")">Cancel</a><button class="button button-primary" @onclick="ConfirmAsync" disabled="@_saving">@(_saving ? "Proposing…" : "Confirm proposal")</button></div> }
@code { [Parameter] public Guid DraftId { get; set; } private PrepareProposalResult? _prepared; private MemberId? _author; private readonly OperationId _operationId = OperationId.New(); private bool _loading = true; private bool _saving; private string? _error; protected override async Task OnParametersSetAsync() { _loading = true; try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub) || DraftId == Guid.Empty) return; _author = new MemberId(sub); _prepared = await Proposals.PrepareAsync(Organization.Id, _author, new AdrId(DraftId)); } finally { _loading = false; } } private async Task ConfirmAsync() { if (_saving || _author is null || _prepared?.Draft is null) return; _saving = true; try { var result = await Proposals.ProposeAsync(new ProposeCommand(Organization.Id, _author, new AdrId(DraftId), _prepared.Draft.Version, _operationId)); if (result.IsSuccess) { Navigation.NavigateTo($"/proposals/{result.Proposal!.Id.Value:D}"); return; } _error = result.Status == ProposalWriteStatus.Conflict ? "The draft changed after this preview. Return to the draft and review the current version." : result.Errors.Count > 0 ? string.Join(" ", result.Errors.Select(e => e.Message)) : "The proposal could not be completed."; } finally { _saving = false; } } }
