@page "/members"
@using AdrCampus.Application.Membership
@using AdrCampus.Web.Drafts
@inject MembershipObservationService Observation
@inject CurrentOrganization Organization

<PageTitle>Members</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Organization</span>
        <h1>Members</h1>
        <p>The current roster derived from the organization’s SSO groups.</p>
    </div>
</div>

@if (_isLoading)
{
    <section class="placeholder-panel roster-message" aria-live="polite">
        <span class="roster-spinner" aria-hidden="true"></span>
        <div><h2>Loading current roster</h2><p>Checking the organization directory…</p></div>
    </section>
}
else if (_result is { IsAvailable: false })
{
    <section class="placeholder-panel roster-message roster-error" role="alert">
        <span class="roster-status-icon" aria-hidden="true">!</span>
        <div>
            <h2>Member roster unavailable</h2>
            <p>@_result.ErrorMessage</p>
            <button class="button button-secondary" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    </section>
}
else if (_result is { Snapshot.Members.Count: 0 })
{
    <section class="placeholder-panel">
        <h2>No active members</h2>
        <p>The configured member group currently contains no enabled identities.</p>
    </section>
}
else if (_result?.Snapshot is not null)
{
    <div class="roster-summary">
        <p><strong>@_result.Snapshot.Members.Count</strong> active @(_result.Snapshot.Members.Count == 1 ? "member" : "members")</p>
        <p>Current as of <time datetime="@_result.Snapshot.ObservedAtUtc.ToString("O")">@_result.Snapshot.ObservedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</time></p>
    </div>
    <section class="member-list" aria-label="Current organization members">
        @foreach (var member in _result.Snapshot.Members)
        {
            <article class="member-row">
                <span class="member-avatar" aria-hidden="true">@Initials(member.DisplayName)</span>
                <div class="member-identity"><h2>@member.DisplayName</h2></div>
                <span class="role-badge @(member.IsMaintainer ? "role-maintainer" : "")">
                    @(member.IsMaintainer ? "Maintainer" : "Member")
                </span>
            </article>
        }
    </section>
}

@code {
    private MembershipSyncResult? _result;
    private bool _isLoading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _result = await Observation.SynchronizeAsync(Organization.Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Initials(string displayName)
    {
        var words = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    }
}
