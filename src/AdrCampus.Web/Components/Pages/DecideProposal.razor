@page "/proposals/{ProposalId:guid}/decide/{Outcome}"
@using AdrCampus.Application.Proposals
@using AdrCampus.Core.Domain
@using AdrCampus.Web.Drafts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProposalApplicationService Proposals
@inject CurrentOrganization Organization
@inject NavigationManager Navigation
<PageTitle>Decide proposal</PageTitle>
@if (_loading) { <section class="placeholder-panel"><h1>Preparing decision</h1></section> }
else if (_proposal is null) { <section class="placeholder-panel"><h1>Proposal unavailable</h1><p>This proposal is no longer awaiting your decision, or maintainer access is unavailable.</p><a class="button button-secondary" href="@UnavailableReturnLink">Return to results</a></section> }
else if (!_confirming) { <div class="page-header"><div><span class="eyebrow">Maintainer decision</span><h1>@ActionText @_proposal.Content.Title.Value</h1><p>@Instruction</p></div></div><section class="form-placeholder">@if (_errors.Count > 0) { <div class="form-message form-error" role="alert"><ul>@foreach (var error in _errors) { <li>@error.Message</li> }</ul></div> }<label for="decision-note">@NoteLabel <span>@NoteRequirement · maximum 1,000 characters</span></label><textarea id="decision-note" rows="6" maxlength="1000" @bind="_note"></textarea><div class="form-actions"><a class="button button-secondary" href="@ProposalLink">Cancel</a><button class="button button-primary" @onclick="ReviewAsync">Review decision</button></div></section> }
else { <div class="preview-banner">Confirmation required · This @_outcome.ToString().ToLowerInvariant() decision is final</div><div class="page-header"><div><span class="eyebrow">Decision preview</span><h1>@ActionText @_proposal.Content.Title.Value</h1><p>Confirming decides the exact proposal shown below.</p></div></div>@if (_error is not null) { <div class="form-message form-error" role="alert">@_error</div> }<article class="adr-preview"><section><h2>Outcome</h2><p>@_outcome</p></section><section><h2>@NoteLabel</h2><p>@(string.IsNullOrEmpty(_normalizedNote) ? "No note will be recorded." : _normalizedNote)</p></section></article><div class="confirmation-actions"><button class="button button-secondary" @onclick="EditNote" disabled="@_saving">Back</button><button class="button button-primary" @onclick="ConfirmAsync" disabled="@_saving">@(_saving ? "Recording…" : "Confirm final decision")</button></div> }
@code {
    [Parameter] public Guid ProposalId { get; set; }
    [Parameter] public string Outcome { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private AdrProposal? _proposal; private MemberId? _decider; private DecisionOutcome _outcome; private string _note = string.Empty; private string _normalizedNote = string.Empty; private IReadOnlyList<DecisionNoteValidationError> _errors = []; private string? _error; private bool _loading = true; private bool _confirming; private bool _saving; private readonly OperationId _operationId = OperationId.New();
    private string ActionText => _outcome == DecisionOutcome.Accepted ? "Accept" : "Reject";
    private string NoteLabel => _outcome == DecisionOutcome.Accepted ? "Acceptance note" : "Rejection reason";
    private string NoteRequirement => _outcome == DecisionOutcome.Accepted ? "Optional" : "Required";
    private string Instruction => _outcome == DecisionOutcome.Accepted ? "You may record an optional note before reviewing the final outcome." : "Record the reason for rejection before reviewing the final outcome.";
    private bool HasSafeReturn => DiscoveryReturnContext.IsSafe(ReturnUrl);
    private string ProposalLink => HasSafeReturn ? $"proposals/{ProposalId:D}?returnUrl={Uri.EscapeDataString(ReturnUrl!)}" : $"proposals/{ProposalId:D}";
    private string UnavailableReturnLink => HasSafeReturn ? ReturnUrl! : "proposed";
    protected override async Task OnParametersSetAsync() { _loading = true; try { if (!TryOutcome()) return; var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub) || ProposalId == Guid.Empty) return; _decider = new MemberId(sub); var prepared = await Proposals.PrepareDecisionAsync(Organization.Id, _decider, new AdrId(ProposalId), _outcome, _note); _proposal = prepared.IsAuthorized && prepared.IsFound ? prepared.Proposal : null; } finally { _loading = false; } }
    private async Task ReviewAsync() { if (_proposal is null || _decider is null) return; var prepared = await Proposals.PrepareDecisionAsync(Organization.Id, _decider, new AdrId(ProposalId), _outcome, _note); _errors = prepared.Errors; if (prepared.IsReady) { _normalizedNote = prepared.Note!; _confirming = true; } }
    private void EditNote() { _confirming = false; _error = null; }
    private async Task ConfirmAsync() { if (_saving || _proposal is null || _decider is null) return; _saving = true; try { var result = await Proposals.DecideAsync(new(Organization.Id, _proposal.Id, _proposal.ProposedAtUtc, _decider, _outcome, _normalizedNote, _operationId)); if (result.IsSuccess) { Navigation.NavigateTo($"/{ProposalLink}"); return; } _error = result.Status == AdrCampus.Core.Proposals.DecisionWriteStatus.Conflict ? "Another maintainer has already decided this proposal." : result.Errors.Count > 0 ? string.Join(" ", result.Errors.Select(e => e.Message)) : "The decision could not be recorded."; } finally { _saving = false; } }
    private bool TryOutcome() { if (Outcome.Equals("accept", StringComparison.OrdinalIgnoreCase)) { _outcome = DecisionOutcome.Accepted; return true; } if (Outcome.Equals("reject", StringComparison.OrdinalIgnoreCase)) { _outcome = DecisionOutcome.Rejected; return true; } return false; }
}
