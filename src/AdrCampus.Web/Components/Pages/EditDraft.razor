@page "/drafts/{DraftId:guid}/edit"
@using AdrCampus.Application.Drafts
@using AdrCampus.Core.Domain
@using AdrCampus.Web.Drafts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DraftApplicationService Drafts
@inject CurrentOrganization Organization
@inject NavigationManager Navigation
<PageTitle>Edit draft</PageTitle>
@if (_loading) { <section class="placeholder-panel"><h1>Loading draft</h1></section> }
else if (_version == 0) { <section class="placeholder-panel"><h1>Draft not found</h1><a class="button button-secondary" href="drafts">My drafts</a></section> }
else { <div class="page-header"><div><span class="eyebrow">Edit draft</span><h1>@_model.Title</h1><p>Changes remain private until you propose this ADR.</p></div></div><EditForm Model="_model" OnSubmit="SaveAsync" FormName="edit-draft" class="form-placeholder">
    @if (_error is not null) { <div class="form-message form-error" role="alert">@_error</div> }
    <label for="title">Title <span>Required · 5–160 characters</span></label><InputText id="title" @bind-Value="_model.Title" maxlength="160" />@if (_titleError is not null) { <p class="field-error">@_titleError</p> }
    <label for="context">Context</label><InputTextArea id="context" @bind-Value="_model.Context" rows="4" /><label for="decision">Decision</label><InputTextArea id="decision" @bind-Value="_model.Decision" rows="4" /><label for="consequences">Consequences</label><InputTextArea id="consequences" @bind-Value="_model.Consequences" rows="4" />
    <label for="replacement-target">Intended replacement target <span>Optional · accepted decisions only</span></label><select id="replacement-target" @bind="_model.TargetId"><option value="">None — ordinary draft</option>@foreach (var target in _targets) { <option value="@target.Id.Value.ToString("D")">@target.Title.Value</option> }</select>
    @if (!string.IsNullOrEmpty(_model.TargetId)) { <p class="field-guidance">Changing this selection does not change either accepted decision.</p> }
    <div class="form-actions"><a class="button button-secondary" href="@($"drafts/{DraftId:D}")">Cancel</a><button class="button button-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save changes")</button></div>
</EditForm> }
@code {
    [Parameter] public Guid DraftId { get; set; }
    private readonly Model _model = new(); private OperationId _operationId = OperationId.New(); private long _version; private bool _loading = true; private bool _saving; private string? _titleError; private string? _error; private MemberId? _author; private IReadOnlyList<EligibleSupersessionTarget> _targets = [];
    protected override async Task OnParametersSetAsync() { _loading = true; try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub) || DraftId == Guid.Empty) return; _author = new MemberId(sub); var result = await Drafts.GetMineAsync(Organization.Id, _author, new AdrId(DraftId)); if (result.Draft is null) return; var d = result.Draft; _version = d.Version; _model.Title = d.Content.Title.Value; _model.Context = d.Content.Context; _model.Decision = d.Content.Decision; _model.Consequences = d.Content.Consequences; _model.TargetId = d.IntendedSupersessionTargetId?.Value.ToString("D") ?? ""; _targets = (await Drafts.ListEligibleSupersessionTargetsAsync(Organization.Id, _author, d.Id)).Targets; } finally { _loading = false; } }
    private async Task SaveAsync() { if (_saving || _author is null) return; _saving = true; _titleError = null; _error = null; try { AdrId? target = Guid.TryParse(_model.TargetId, out var targetId) && targetId != Guid.Empty ? new AdrId(targetId) : null; var result = await Drafts.ReviseAsync(new ReviseDraftCommand(new AdrId(DraftId), _operationId, Organization.Id, _author, _version, _model.Title, _model.Context, _model.Decision, _model.Consequences, target)); if (result.IsSuccess) { Navigation.NavigateTo($"/drafts/{DraftId:D}"); return; } if (result.Status == ReviseDraftStatus.Invalid && result.TargetValidationCode is null) _titleError = result.ErrorMessage; else _error = result.ErrorMessage; } finally { _saving = false; } }
    private sealed class Model { public string Title { get; set; } = ""; public string Context { get; set; } = ""; public string Decision { get; set; } = ""; public string Consequences { get; set; } = ""; public string TargetId { get; set; } = ""; }
}
