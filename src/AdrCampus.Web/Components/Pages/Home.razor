@page "/"
@using AdrCampus.Application.Proposals
@using AdrCampus.Core.Domain
@using AdrCampus.Core.Proposals
@using AdrCampus.Web.Drafts
@using AdrCampus.Web.Members
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProposalApplicationService Proposals
@inject CurrentOrganization Organization
@inject MemberRosterService Roster
<PageTitle>Current decisions</PageTitle>
<div class="page-header"><div><span class="eyebrow">Decision record</span><h1>Current decisions</h1><p>Accepted architectural decisions currently in effect.</p></div><a class="button button-primary" href="drafts/new">New ADR</a></div>
@if (_loading) { <section class="placeholder-panel"><h2>Loading current decisions</h2></section> }
else if (_items.Count == 0) { <section class="empty-state" aria-labelledby="empty-current-title"><span class="empty-icon" aria-hidden="true">A</span><h2 id="empty-current-title">No accepted decisions yet</h2><p>Once a maintainer accepts a proposal, it will appear here as part of the current architectural record.</p><a class="button button-secondary" href="drafts/new">Draft the first decision</a></section> }
else { <section class="draft-list">@foreach (var item in _items) { <a class="draft-row" href="@($"proposals/{item.Id.Value:D}")"><span class="draft-identity"><strong>@item.Title.Value</strong><small>Accepted @item.Decision.DecidedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt") · Author @_names.For(item.AuthorId.Value) · Decider @_names.For(item.Decision.DeciderId.Value)</small></span><span class="role-badge role-accepted">Accepted</span></a> }</section> }
@code { private IReadOnlyList<DecidedSummary> _items = []; private MemberDisplayNames _names = new(false, new Dictionary<string, string>()); private bool _loading = true; protected override async Task OnInitializedAsync() { try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub)) return; var result = await Proposals.ListDecidedAsync(Organization.Id, new MemberId(sub), DecisionOutcome.Accepted); if (result.IsAuthorized && result.Value is not null) { _items = result.Value; _names = await Roster.GetDisplayNamesAsync(); } } finally { _loading = false; } } }
