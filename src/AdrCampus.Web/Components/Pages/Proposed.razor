@page "/proposed"
@using AdrCampus.Application.Proposals
@using AdrCampus.Core.Domain
@using AdrCampus.Core.Proposals
@using AdrCampus.Web.Drafts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProposalApplicationService Proposals
@inject CurrentOrganization Organization
<PageTitle>Proposed decisions</PageTitle><div class="page-header"><div><span class="eyebrow">Decision record</span><h1>Proposed decisions</h1><p>ADRs awaiting a maintainer decision.</p></div></div>
@if (_loading) { <section class="placeholder-panel"><h2>Loading proposals</h2></section> } else if (_items.Count == 0) { <section class="placeholder-panel"><h2>No proposals awaiting review</h2><p>Submitted drafts will appear here while they are under consideration.</p></section> } else { <section class="draft-list">@foreach (var item in _items) { <a class="draft-row" href="@($"proposals/{item.Id.Value:D}")"><span class="draft-identity"><strong>@item.Title.Value</strong><small>Proposed @item.ProposedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small></span><span class="role-badge role-proposed">Proposed</span></a> }</section> }
@code { private IReadOnlyList<ProposalSummary> _items = []; private bool _loading = true; protected override async Task OnInitializedAsync() { try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub)) return; var result = await Proposals.ListAsync(Organization.Id, new MemberId(sub)); if (result.IsAuthorized && result.Value is not null) _items = result.Value; } finally { _loading = false; } } }
