@page "/proposals/{ProposalId:guid}"
@using AdrCampus.Application.Proposals
@using AdrCampus.Core.Domain
@using AdrCampus.Web.Drafts
@using AdrCampus.Web.Members
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProposalApplicationService Proposals
@inject CurrentOrganization Organization
@inject MemberRosterService Roster
<PageTitle>@(_proposal?.Content.Title.Value ?? "Proposal")</PageTitle>
@if (_loading) { <section class="placeholder-panel"><h1>Loading proposal</h1></section> } else if (_proposal is null) { <section class="placeholder-panel"><h1>ADR not found</h1><a class="button button-secondary" href="proposed">Proposed decisions</a></section> } else { <div class="page-header"><div><span class="eyebrow">@(_proposal.Status == AdrLifecycleStatus.Proposed ? "Proposed ADR" : "Decision record")</span><h1>@_proposal.Content.Title.Value</h1><p>@StatusLine</p></div><a class="button button-secondary" href="@BackLink">@BackLabel</a></div><article class="adr-preview"><div class="adr-status"><span class="role-badge @StatusClass">@_proposal.Status</span><span>Author @Name(_proposal.AuthorId) · Proposer @Name(_proposal.ProposerId)</span></div><section><h2>Context</h2><p>@_proposal.Content.Context</p></section><section><h2>Decision</h2><p>@_proposal.Content.Decision</p></section><section><h2>Consequences</h2><p>@_proposal.Content.Consequences</p></section>@if (_proposal.FinalDecision is not null) { <section><h2>@(_proposal.FinalDecision.Outcome == DecisionOutcome.Accepted ? "Acceptance note" : "Rejection reason")</h2><p>@(string.IsNullOrEmpty(_proposal.FinalDecision.Note) ? "No note recorded." : _proposal.FinalDecision.Note)</p><small>Decided by @Name(_proposal.FinalDecision.DeciderId) on @_proposal.FinalDecision.DecidedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small></section> }</article>@if (_proposal.FinalDecision is null && _isMaintainer && !ViewAsMember) { <div class="confirmation-actions"><a class="button button-secondary" href="@($"proposals/{ProposalId:D}/decide/reject")">Reject</a><a class="button button-primary" href="@($"proposals/{ProposalId:D}/decide/accept")">Accept</a></div> } }
@code { [Parameter] public Guid ProposalId { get; set; } [CascadingParameter(Name = "ViewAsMember")] public bool ViewAsMember { get; set; } private AdrProposal? _proposal; private MemberDisplayNames _names = new(false, new Dictionary<string, string>()); private bool _isMaintainer; private bool _loading = true; private string Name(MemberId id) => _names.For(id.Value); private string StatusLine => _proposal?.FinalDecision is null ? $"Under consideration · Proposed {_proposal?.ProposedAtUtc.ToLocalTime():MMM d, yyyy 'at' h:mm tt}" : $"{_proposal.Status} · Decided {_proposal.FinalDecision.DecidedAtUtc.ToLocalTime():MMM d, yyyy 'at' h:mm tt}"; private string StatusClass => _proposal?.Status switch { AdrLifecycleStatus.Accepted => "role-accepted", AdrLifecycleStatus.Rejected => "role-rejected", _ => "role-proposed" }; private string BackLink => _proposal?.Status == AdrLifecycleStatus.Accepted ? "" : _proposal?.Status == AdrLifecycleStatus.Rejected ? "historical" : "proposed"; private string BackLabel => _proposal?.Status == AdrLifecycleStatus.Accepted ? "Current decisions" : _proposal?.Status == AdrLifecycleStatus.Rejected ? "Historical decisions" : "All proposals"; protected override async Task OnParametersSetAsync() { _loading = true; try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (!string.IsNullOrWhiteSpace(sub) && ProposalId != Guid.Empty) { _proposal = (await Proposals.GetAsync(Organization.Id, new MemberId(sub), new AdrId(ProposalId))).Value; var roster = await Roster.GetCurrentAsync(); _names = new(roster.IsAvailable, roster.Members.ToDictionary(member => member.SubjectId, member => member.DisplayName, StringComparer.Ordinal)); var current = roster.Members.FirstOrDefault(member => member.SubjectId == sub); _isMaintainer = roster.IsAvailable && current is { IsMaintainer: true }; } } finally { _loading = false; } } }
