@page "/proposals/{ProposalId:guid}"
@using AdrCampus.Application.Discovery
@using AdrCampus.Core.Domain
@using AdrCampus.Web.Drafts
@using AdrCampus.Web.Members
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DiscoveryApplicationService Discovery
@inject CurrentOrganization Organization
@inject MemberRosterService Roster
<PageTitle>@(_detail?.Record.Content.Title.Value ?? "ADR")</PageTitle>
@if (_loading) { <section class="placeholder-panel"><h1>Loading ADR</h1></section> }
else if (_status == SharedDetailStatus.Unavailable) { <section class="placeholder-panel" role="alert"><h1>Decision record temporarily unavailable</h1><p>No partial record is being shown.</p></section> }
else if (_detail is null) { <section class="placeholder-panel"><h1>ADR not found</h1><a class="button button-secondary" href="@BackLink">@BackLabel</a></section> }
else { <div class="page-header"><div><span class="eyebrow">@(_detail.Record.Status == AdrLifecycleStatus.Proposed ? "Proposed ADR" : "Decision record")</span><h1>@_detail.Record.Content.Title.Value</h1><p>@StatusLine</p></div><a class="button button-secondary" href="@BackLink">@BackLabel</a></div><article class="adr-preview"><div class="adr-status"><span class="role-badge @StatusClass">@_detail.Record.Status</span><span class="record-id">ADR @_detail.Record.Id.Value.ToString("D")</span></div><section class="record-metadata"><div><strong>Author</strong><span>@_detail.Author.DisplayName</span><small>Created @_detail.Record.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small></div><div><strong>Proposer</strong><span>@_detail.Proposer.DisplayName</span><small>Proposed @_detail.Record.ProposedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small></div>@if (_detail.Decider is not null && _detail.Record.FinalDecision is not null) { <div><strong>Decider</strong><span>@_detail.Decider.DisplayName</span><small>Decided @_detail.Record.FinalDecision.DecidedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</small></div> }</section><section><h2>Context</h2><p>@_detail.Record.Content.Context</p></section><section><h2>Decision</h2><p>@_detail.Record.Content.Decision</p></section><section><h2>Consequences</h2><p>@_detail.Record.Content.Consequences</p></section>@if (_detail.Record.FinalDecision is not null) { <section><h2>@(_detail.Record.FinalDecision.Outcome == DecisionOutcome.Accepted ? "Acceptance note" : "Rejection reason")</h2><p>@(string.IsNullOrEmpty(_detail.Record.FinalDecision.Note) ? "No note recorded." : _detail.Record.FinalDecision.Note)</p></section> }@if (_detail.Relationships.Count > 0) { <section><h2>Related decisions</h2>@foreach (var relationship in _detail.Relationships) { <a href="@($"proposals/{relationship.RelatedId.Value:D}")">@relationship.Direction: @relationship.RelatedTitle.Value</a> }</section> }</article><section class="lifecycle-history" aria-labelledby="history-title"><h2 id="history-title">Lifecycle history</h2><ol>@foreach (var item in _detail.History) { <li><span class="history-marker" aria-hidden="true"></span><div><strong>@item.Label</strong><p>@item.Actor.DisplayName · <time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</time></p>@if (!string.IsNullOrEmpty(item.Note)) { <p>@item.Note</p> }</div></li> }</ol></section>@if (_detail.Record.FinalDecision is null && _isMaintainer && !ViewAsMember) { <div class="confirmation-actions"><a class="button button-secondary" href="@DecisionLink("reject")">Reject</a><a class="button button-primary" href="@DecisionLink("accept")">Accept</a></div> } }
@if (_detail?.IntendedSupersessionTarget is not null) { <section class="placeholder-panel"><span class="eyebrow">@TargetEyebrow</span><h2>@TargetHeading @_detail.IntendedSupersessionTarget.Title.Value</h2><p class="record-id">ADR @_detail.IntendedSupersessionTarget.Id.Value.ToString("D") · @_detail.IntendedSupersessionTarget.Status</p><p>@TargetExplanation</p><a href="@($"proposals/{_detail.IntendedSupersessionTarget.Id.Value:D}")">View target decision</a></section> }
@if (_detail?.ProposedReplacements is { Count: > 0 }) { <section class="placeholder-panel"><span class="eyebrow">@InboundProposalEyebrow</span><h2>@InboundProposalHeading</h2><p>@InboundProposalExplanation</p><ul>@foreach (var replacement in _detail.ProposedReplacements) { <li><a href="@($"proposals/{replacement.Id.Value:D}")">@replacement.Title.Value</a> <span class="record-id">ADR @replacement.Id.Value.ToString("D")</span></li> }</ul></section> }
@if (_detail?.Record.Status == AdrLifecycleStatus.Accepted) { <div class="confirmation-actions"><a class="button button-primary" href="@($"drafts/new?replacementFor={ProposalId:D}")">Propose a replacement</a></div> }
@code {
    [Parameter] public Guid ProposalId { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [CascadingParameter(Name = "ViewAsMember")] public bool ViewAsMember { get; set; }
    private SharedRecordDetail? _detail; private SharedDetailStatus _status; private bool _isMaintainer; private bool _loading = true;
    private bool HasSafeReturn => DiscoveryReturnContext.IsSafe(ReturnUrl);
    private string BackLink => HasSafeReturn ? ReturnUrl! : _detail?.Record.Status == AdrLifecycleStatus.Accepted ? "/" : _detail?.Record.Status is AdrLifecycleStatus.Rejected or AdrLifecycleStatus.Superseded ? "/historical" : "/proposed";
    private string BackLabel => HasSafeReturn ? "Back to results" : _detail?.Record.Status == AdrLifecycleStatus.Accepted ? "Current decisions" : _detail?.Record.Status is AdrLifecycleStatus.Rejected or AdrLifecycleStatus.Superseded ? "Historical decisions" : "All proposals";
    private string TargetEyebrow => _detail?.Record.Supersedes is not null ? "Completed supersession" : "Frozen intended target · Read-only";
    private string TargetHeading => _detail?.Record.Supersedes is not null ? "Supersedes" : "Intends to supersede";
    private string TargetExplanation => _detail?.Record.Supersedes is not null ? "This replacement was accepted and the earlier decision was superseded atomically at the recorded decision time." : _detail?.Record.Status == AdrLifecycleStatus.Rejected ? "This frozen replacement intent is retained as history. Rejection left the target accepted and unchanged." : _detail?.IntendedSupersessionTarget?.Status != AdrLifecycleStatus.Accepted ? "This proposal is stale because its frozen target is no longer accepted. It cannot be accepted and remains Proposed until a maintainer rejects it with a reason." : "This target was frozen when the ADR was proposed and cannot be changed. The target remains in effect unless this replacement is accepted.";
    private bool HasStaleInboundProposals => _detail?.Record.Status != AdrLifecycleStatus.Accepted;
    private string InboundProposalEyebrow => HasStaleInboundProposals ? "Stale replacement proposals" : "Pending replacement proposals";
    private string InboundProposalHeading => HasStaleInboundProposals ? $"{_detail!.ProposedReplacements!.Count} proposal{(_detail.ProposedReplacements.Count == 1 ? "" : "s")} can no longer replace this decision" : $"{_detail!.ProposedReplacements!.Count} proposal{(_detail.ProposedReplacements.Count == 1 ? "" : "s")} intend{(_detail.ProposedReplacements.Count == 1 ? "s" : "")} to replace this decision";
    private string InboundProposalExplanation => HasStaleInboundProposals ? "This decision has already been superseded. These competing proposals remain Proposed for historical accuracy, cannot be accepted against this target, and must be rejected by a maintainer with a reason." : "This ADR remains accepted and in effect. Concurrent replacement proposals are allowed; accepting one prevents the others from being accepted against this target.";
    private string StatusLine => _detail?.Record.Status switch { AdrLifecycleStatus.Proposed => $"Awaiting a decision · Proposed {_detail.Record.ProposedAtUtc.ToLocalTime():MMM d, yyyy 'at' h:mm tt}", AdrLifecycleStatus.Accepted => "Accepted and currently in effect", AdrLifecycleStatus.Rejected => "Rejected and retained as organizational history", AdrLifecycleStatus.Superseded => "Superseded and retained as organizational history", _ => "Shared organizational record" };
    private string StatusClass => _detail?.Record.Status switch { AdrLifecycleStatus.Accepted => "role-accepted", AdrLifecycleStatus.Rejected => "role-rejected", AdrLifecycleStatus.Superseded => "role-superseded", _ => "role-proposed" };
    protected override async Task OnParametersSetAsync() { _loading = true; try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var sub = auth.User.FindFirst("sub")?.Value; if (string.IsNullOrWhiteSpace(sub) || ProposalId == Guid.Empty) return; var result = await Discovery.GetDetailAsync(Organization.Id, new MemberId(sub), new AdrId(ProposalId)); _status = result.Status; _detail = result.Detail; var membership = await Roster.GetMembershipAsync(sub); _isMaintainer = membership.IsAvailable && membership.IsMember && membership.IsMaintainer; } finally { _loading = false; } }
    private string DecisionLink(string outcome) { var baseLink = $"proposals/{ProposalId:D}/decide/{outcome}"; return HasSafeReturn ? $"{baseLink}?returnUrl={Uri.EscapeDataString(ReturnUrl!)}" : baseLink; }
}
